# Assistant Emily Development Environment Configuration
# 로컬 개발 및 통합 테스트 시 사용할 환경 설정 템플릿입니다.
# 실제 사용 시 본 파일을 복사하여 `.env`로 저장한 후 필요한 값을 입력하십시오.

# LLM API 엔드포인트 URL (OpenAI 호환 API, Ollama, LM Studio 또는 자체 프록시)
EMILY_PROXY_URL=http://localhost:11434/v1

# LLM API 인증 키 (로컬 Ollama, LM Studio 등 무인증 환경에서는 공란 유지)
EMILY_API_KEY=

# 기본 모델 이름 (예: auto, gpt-4o, gemini-3.6-flash, llama3, qwen2.5)
EMILY_MODEL=auto

# (선택 사항) 로컬 개발 빌드 시 번들을 자동으로 동기화할 Obsidian Vault 플러그인 절대 경로
# OBSIDIAN_VAULT_PATH=C:/Users/username/Documents/MyVault/.obsidian/plugins/obsidian-assistant-emily
