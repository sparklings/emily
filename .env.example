# ==============================================================================
# Assistant Emily - 개발 및 로컬 테스트 환경 설정 템플릿 (.env.example)
# ==============================================================================
# 로컬 개발(esbuild) 및 통합 테스트(npm test) 실행 시 사용할 환경 변수 정의입니다.
# 본 파일을 복사하여 프로젝트 루트에 `.env` 파일을 생성한 후 필요한 값을 입력하십시오.
# (참고: .env 파일은 .gitignore에 등록되어 버전 관리에서 제외됩니다)

# ------------------------------------------------------------------------------
# 1. 통합 테스트용 LLM 엔드포인트 설정 (tests/integration_test.mjs)
# ------------------------------------------------------------------------------
# 테스트 대상 OpenAI 호환 API URL (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1, OpenAI: https://api.openai.com/v1)
EMILY_PROXY_URL=http://localhost:11434/v1

# LLM API 인증 키 (로컬 Ollama, LM Studio 등 인증이 필요 없는 환경에서는 공란 유지)
EMILY_API_KEY=

# 테스트 대상 LLM 모델 식별자 (예: auto, llama3.2, qwen2.5, gpt-4o-mini 등)
# 기본값은 'auto'이며, 로컬 모델 사용 시 설치된 모델명을 지정할 수 있습니다.
EMILY_MODEL=auto

# ------------------------------------------------------------------------------
# 2. 로컬 빌드 자동 동기화 설정 (esbuild.config.mjs)
# ------------------------------------------------------------------------------
# `npm run build` 또는 `npm run dev` 실행 시 번들(main.js, manifest.json, styles.css)을
# 자동으로 복사하여 즉시 테스트할 옵시디언 볼트의 플러그인 디렉터리 절대 경로입니다.
# (미설정 시 OneDrive 기본 경로 및 PlugVaults 기본 경로가 탐색됩니다)
#
# Windows 예시:
# OBSIDIAN_VAULT_PATH=C:/Users/username/Documents/MyVault/.obsidian/plugins/assistant-emily
# macOS / Linux 예시:
# OBSIDIAN_VAULT_PATH=/Users/username/Documents/MyVault/.obsidian/plugins/assistant-emily

